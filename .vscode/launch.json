{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🐳 Attach to Backend (Docker)",
      "type": "node",
      "request": "attach",
      "restart": true,
      "port": 9229,
      "address": "localhost",
      "localRoot": "${workspaceFolder}/backend",
      "remoteRoot": "/app",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Debug Flutter App",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug",
      "cwd": "${workspaceFolder}/frontend"
    }
  ]
}
