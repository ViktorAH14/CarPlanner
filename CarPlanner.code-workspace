{
  "folders": [
    {
      "path": ".",
      "name": "CarPlanner Root"
    }
  ],
  "settings": {
    "terminal.integrated.defaultProfile.linux": "zsh",
    "files.exclude": {
      "**/.git": true,
      "**/node_modules": true,
      "**/.dart_tool": true,
      "**/build": true,
      "**/*.log": true
    },
    "workbench.colorCustomizations": {
      "activityBar.background": "#2d333b",
      "titleBar.activeBackground": "#373d46",
      "titleBar.activeForeground": "#ffffff"
    }
    // ВАЖНО: Никаких [javascript], [dart], eslint.validate и files.associations здесь быть не должно!
  },
  "extensions": {
    "recommendations": [
      "Dart-Code.dart-code",
      "Dart-Code.flutter",
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode",
      "ms-azuretools.vscode-docker",
      "ms-vscode.vscode-nodejs-extension-pack"
    ]
  }
}
