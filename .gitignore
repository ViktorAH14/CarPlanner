# ==========================
# General Ignored Files
# ==========================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Logs and temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment variables and secrets
# NEVER commit .env files or private keys to version control
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.key
*.pem
*.crt
*.pfx
*.p12

# Documentation / Developer notes (if stored in root)
TODO.md
notes.md


# ==========================
# Backend (Node.js + Express)
# ==========================
/backend/node_modules/
/backend/dist/
/backend/.next/
/backend/build/

# Node.js test coverage reports
/backend/coverage/
/backend/.nyc_output/

# IDE configurations (Node.js)
/backend/.idea/
/backend/*.iml
/backend/.vscode/
/backend/.classpath
/backend/.project
/backend/.settings/


# ==========================
# Frontend (Flutter)
# ==========================
/frontend/.dart_tool/
/frontend/build/
/frontend/ios/Flutter/Flutter.framework
/frontend/android/app/release/
/frontend/android/app/debug/
/frontend/windows/flutter/ephemeral/
/frontend/macos/Flutter/ephemeral/
/frontend/linux/flutter/ephemeral/

# Flutter package lock file
/frontend/pubspec.lock

# IDE configurations (Flutter)
/frontend/.idea/
/frontend/*.iml
/frontend/.vscode/
/frontend/.classpath
/frontend/.project
/frontend/.settings/

# Platform-specific certificates and keys for Flutter
/frontend/android/key.properties
/frontend/android/app/*.keystore
/frontend/android/app/*.jks
/frontend/ios/Runner/Debug.xcconfig
/frontend/ios/Runner/Release.xcconfig


# ==========================
# Database and Docker
# ==========================
# Ignore actual database data files, but DO NOT ignore migrations or seeders
/backend/data/
*.sql.dump
*.bak

# Docker compose override for local development (keeps local configs out of repo)
docker-compose.override.yml

# Docker build artifacts
**/Dockerfile.dev
**/Dockerfile.debug


# ==========================
# Miscellaneous
# ==========================
# CI/CD build artifact folders
.github/workflows/artifacts/
.gitlab-ci/artifacts/

# Local temporary files and drafts
*.tmp
*.temp
