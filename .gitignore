# ==========================
# Frontend (Flutter)
# ==========================
/frontend/.dart_tool/
/frontend/build/
/frontend/ios/Flutter/Flutter.framework
/frontend/android/app/release/
/frontend/android/app/debug/
/frontend/windows/flutter/ephemeral/
/frontend/macos/Flutter/ephemeral/
/frontend/linux/flutter/ephemeral/

# Пакеты Flutter
/frontend/pubspec.lock
# Раскомментируйте, если НЕ хотите фиксировать pubspec.lock в репозитории.
# Обычно для библиотек его фиксируют, а для приложений — тоже часто фиксируют, 
# чтобы версии зависимостей были стабильны. Если хотите игнорировать — раскомментируйте строку выше.

# IDE (Flutter)
/frontend/.idea/
/frontend/*.iml
/frontend/.vscode/
/frontend/.classpath
/frontend/.project
/frontend/.settings/

# Сертификаты и ключи для Flutter платформ
/frontend/android/key.properties
/frontend/android/app/*.keystore
/frontend/android/app/*.jks
/frontend/ios/Runner/Debug.xcconfig
/frontend/ios/Runner/Release.xcconfig


