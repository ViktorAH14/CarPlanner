# ==========================
# General Ignored Files
# ==========================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# =========================
# Logs and temporary files
# =========================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.class
*.swp
.build/
.history
.svn/
.swiftpm/
migrate_working_dir/

# =================================
# Environment variables and secrets
# =================================
# NEVER commit .env files or private keys to version control
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.key
*.pem
*.crt
*.pfx
*.p12

# ===================================================
# Documentation / Developer notes (if stored in root)
# ===================================================
TODO.md
notes.md


# ==========================
# Backend (Node.js + Express)
# ==========================
/backend/node_modules/
/backend/dist/
/backend/.next/
/backend/build/

# Node.js test coverage reports
/backend/coverage/
/backend/.nyc_output/

# ==========================
# Frontend (Flutter)
# ==========================
/frontend/.metadata
/frontend/android/
/frontend/linux/
/frontend/windows/
/frontend/web/
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
**/doc/api/
**/ephemeral/
**/Flutter.framework
**/build/
/coverage/

# =============================
# Symbolication and obfuscation
# =============================
*.symbols
*.map.json

# ===================================================
# Platform-specific certificates and keys for Flutter
# ===================================================
/frontend/android/key.properties
*.keystore
*.jks

# ==========================
# IDE Configurations (All Projects)
# ==========================
.idea/
*.iml
.classpath
.project
.settings/
.vscode/

# ==========================
# Database and Docker
# ==========================
# Ignore actual database data files, but DO NOT ignore migrations or seeders
/backend/data/
*.sql.dump
*.bak

# Docker compose override for local development (keeps local configs out of repo)
docker-compose.override.yml

# Docker build artifacts
**/Dockerfile.dev
**/Dockerfile.debug

# ==========================
# Miscellaneous
# ==========================
# CI/CD build artifact folders
.github/workflows/artifacts/
.gitlab-ci/artifacts/

# Local temporary files and drafts
*.tmp
*.temp
