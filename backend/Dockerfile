# Базовый образ: Node.js 20 на легковесном Alpine Linux
FROM node:20-alpine

# Устанавливаем рабочую директорию внутри контейнера
WORKDIR /app

# Копируем файлы зависимостей сначала (это ускоряет сборку при изменении кода)
COPY package*.json ./

# Устанавливаем зависимости
# --only=production можно убрать, если нужен nodemon для dev, но для продакшена лучше так
RUN npm ci

# Копируем весь исходный код
COPY . .

# Открываем порт, на котором слушает сервер (у тебя это 3000)
EXPOSE 3000

# Команда запуска
# Если хочешь запускать с nodemon (авто-перезагрузка при изменении файлов), 
# убедись, что nodemon есть в devDependencies, и используй: CMD ["npm", "run", "dev"]
CMD ["node", "server.js"]
